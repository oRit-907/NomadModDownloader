<Project Sdk="Microsoft.NET.Sdk">
  <!-- A BepInEx 5 plugin that hosts BepInEx 6's runtime, so BepInEx 6 (Unity Mono) mods run on BepInEx 5.
       The mirror image of ../BepInEx5Compat, and built from the same lib/ folder (see README.md). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BepInEx6Compat</AssemblyName>
    <RootNamespace>BepInEx6Compat</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Company>AkoRit</Company>
    <Authors>AkoRit</Authors>
    <Copyright>AkoRit</Copyright>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Lib>$(MSBuildThisFileDirectory)../BepInEx5Compat/lib/</Lib>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx" HintPath="$(Lib)bep5/BepInEx.dll" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(Lib)bep6/BepInEx.Core.dll" Private="false" Aliases="BE6" />
    <Reference Include="BepInEx.Unity.Mono" HintPath="$(Lib)bep6/BepInEx.Unity.Mono.dll" Private="false" Aliases="BE6" />
    <Reference Include="BepInEx.Unity.Common" HintPath="$(Lib)bep6/BepInEx.Unity.Common.dll" Private="false" Aliases="BE6" />
    <Reference Include="BepInEx.Preloader.Core" HintPath="$(Lib)bep6/BepInEx.Preloader.Core.dll" Private="false" Aliases="BE6" />
    <Reference Include="UnityEngine" HintPath="$(Lib)game/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Lib)game/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
