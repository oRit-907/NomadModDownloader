<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is only used for its WIC image decoder (Nexus serves mod pictures as WebP). -->
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NomadModDownloader</AssemblyName>
    <RootNamespace>NomadModDownloader</RootNamespace>
    <Product>Nomad Mod Downloader</Product>
    <Version>2.6.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published as one self-contained exe, deliberately NOT compressed: compressed single-file bundles look
         "packed" to antivirus heuristics (Nexus's scanners flagged them). Bigger download, fewer false positives. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- App text and AKoRit mod pages in 11 languages. -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename)%(Extension)" />
    <!-- Nomad Drive's menu backgrounds and logo (from the game) and its Noto Sans font (OFL). -->
    <EmbeddedResource Include="Art\*.ttf;Art\discord.png" LogicalName="Art.%(Filename)%(Extension)" />
    <!-- Nomad Drive's mscorlib is stripped; BepInEx needs Mono's full class libraries (MIT). See THIRD-PARTY-NOTICES.md. -->
    <EmbeddedResource Include="Assets\DotNetFix.zip" LogicalName="Assets.DotNetFix.zip" />
    <!-- BepInEx 5 Compatibility (mod/BepInEx5Compat) + BepInEx 5's runtime (MIT): runs BepInEx 5 mods on BepInEx 6. -->
    <EmbeddedResource Include="Assets\BepInEx5Compat.zip" LogicalName="Assets.BepInEx5Compat.zip" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssetRipper.TextureDecoder" Version="1.3.0" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
